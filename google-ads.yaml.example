# Template for `google-ads.yaml` — the Google Ads API client config.
#
# COPY, DO NOT EDIT THIS FILE:
#     cp google-ads.yaml.example google-ads.yaml
#
# `google-ads.yaml` is gitignored (.gitignore line 5) and must stay that way.
# This template carries field names only and never a value. Claude does not read
# or write the real file — CLAUDE.md forbids touching secrets.
#
# Path is configurable via NH_GADS_CONFIG; the default is this repo's root.

# From: Google Ads → manager account → Administrador → Centro de la API.
# A freshly created token starts with TEST-ACCOUNT access and reaches only test
# accounts. Real Keyword Planner volumes need BASIC access, which is a separate
# application from the same page. Both use this one field.
developer_token: ""

# From: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 client
# (type "Desktop app"), with the Google Ads API enabled on the project.
# The developer token alone is NOT enough to make a call.
client_id: ""
client_secret: ""

# Generated once by running Google's OAuth flow with the two values above.
refresh_token: ""

# The MANAGER account that owns the developer token, digits only, no dashes.
# For this project that is 375-041-4091 → 3750414091
login_customer_id: ""

# Required by the current client library.
use_proto_plus: True
