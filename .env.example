# Copy to .env and fill in. .env is gitignored AND blocked from Claude edits.
#
# QUOTE EVERY VALUE. This file is read two ways: pydantic-settings parses it,
# and the cron scripts source it with `set -a; . ./.env`. An unquoted value
# containing spaces or parens -- a User-Agent string, for instance -- is a
# bash syntax error that silently kills the nightly job.

# ---- database -------------------------------------------------------------
# SQLite (default, Phase 0-1). Swap the URL for Postgres with no code change:
#   NH_DATABASE_URL=postgresql+psycopg://nh:nh@localhost:5432/nh
NH_DATABASE_URL="sqlite:///data/niche_hunter.db"

# ---- operations -----------------------------------------------------------
# healthchecks.io ping URL. The nightly job pings this on success; the service
# alerts you when a ping does not arrive. This is the ONLY layer that catches
# 'the machine was off' or 'the cron line is stale' -- a local checker cannot
# mail you about a run that never started. Free tier: period 1 day, grace 6h.
NH_HEALTHCHECK_URL=
# ntfy.sh topic for alerts the job raises itself (a source failed, quota blown).
NH_NTFY_TOPIC=

# ---- youtube data api v3 (niche_hunter_yt) --------------------------------
# 10,000 units/day, resets midnight Pacific. API key only, no OAuth.
NH_YT_API_KEY=
NH_YT_QUOTA_BUDGET="9500"
# The quota lever. Cost = seeds x keywords x 2 sort orders x pages x 100 units.
# 5 seeds x 3 keywords x 1 page = 30 searches = ~3,040 units (32% of budget).
# Raise to 2 only after day 1 confirms the real number.
NH_YT_SEARCH_PAGES="1"
NH_YT_DISCOVER_DAYS="90"
# Max RSS-discovered videos enriched per night (1 unit per 50 ids).
NH_YT_BACKFILL_MAX_IDS="25000"

# ---- youtube rss (niche_hunter_rss) ---------------------------------------
# No auth. Put a real contact address in the UA — these feeds are unofficial.
NH_RSS_USER_AGENT="niche-hunter-rss/0.1 (+you@example.com)"
NH_RSS_WORKERS="8"

# ---- google trends (niche_hunter_trends) ----------------------------------
NH_TRENDS_ANCHOR="documentary"
NH_TRENDS_MIN_GAP_S="2.5"
NH_TRENDS_PROXY=

# ---- reddit (niche_hunter_reddit) -----------------------------------------
# Responsible Builder Policy approval required before any access (2026).
# UA format is mandatory: <platform>:<app_id>:<version> (by u/<username>)
NH_REDDIT_CLIENT_ID=
NH_REDDIT_CLIENT_SECRET=
NH_REDDIT_USER_AGENT=

# ---- google ads keyword planner (niche_hunter_kp) -------------------------
# Digits only, no dashes. Needs Basic access for real volumes.
NH_GADS_CUSTOMER_ID=
NH_GADS_CONFIG="google-ads.yaml"
