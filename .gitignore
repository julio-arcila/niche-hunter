# secrets — never commit, never let Claude edit (see .claude/settings.json deny rules)
.env
.env.*
!.env.example
google-ads.yaml

# data
*.db
*.db-wal
*.db-shm
data/
# Scratch analyses stay local, but the calibration and backtest reports are the
# EVIDENCE for roadmap criterion 4 ("a published precision figure with its base
# rate and known failure modes") and for Gate E. A report that is not committed
# cannot be the evidence for anything, so those are tracked deliberately.
reports/*.md
!reports/.gitkeep
!reports/backtest_*.md
!reports/relevance_*.md
!reports/labelling_criterion.md

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# os / editor
.DS_Store
.idea/
.vscode/

# claude
.claude/settings.local.json

# runtime logs
logs/*
!logs/.gitkeep

# local operational backups (crontab snapshots etc)
.backup/

# Labelling working files; the labelled result belongs in reports/ deliberately.
