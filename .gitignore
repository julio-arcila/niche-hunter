# secrets — never commit, never let Claude edit (see .claude/settings.json deny rules)
.env
.env.*
!.env.example
google-ads.yaml

# data
*.db
*.db-wal
*.db-shm
data/
# Reports are EVIDENCE and are tracked by default. This rule was a whitelist until
# 2026-08-28 -- ignore reports/*.md, then negate each filename prefix that counted as
# evidence -- and it failed silently three times: demand_stratum, gate_e_feasibility and
# geo_value were all written, cited, and never committed, because nobody remembered to
# add a negation for a new prefix. A whitelist of prefixes cannot anticipate the next
# report's name, and its failure mode is the worst available: the file looks saved, the
# commit looks clean, and the evidence for a decision is missing.
#
# Inverted, so it fails safe: everything in reports/ is tracked unless it is explicitly
# named scratch. A report that is not committed cannot be the evidence for anything.
reports/scratch_*
reports/*.tmp

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# os / editor
.DS_Store
.idea/
.vscode/

# claude
.claude/settings.local.json

# runtime logs
logs/*
!logs/.gitkeep

# local operational backups (crontab snapshots etc)
.backup/

# Labelling working files; the labelled result belongs in reports/ deliberately.
.skip-once
