{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Read(./google-ads.yaml)",
      "Edit(./google-ads.yaml)",
      "Edit(./legacy/**)"
    ],
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run nh*)",
      "Bash(uv run alembic*)",
      "Bash(uv sync*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/hooks/block_dangerous_sql.sh",
            "timeout": 10,
            "statusMessage": "Checking for destructive SQL..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.py) uv run ruff format --quiet \"$f\" && uv run ruff check --fix --quiet \"$f\";; esac; } 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "ruff format + fix"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run pytest -q -x --no-header 2>&1 | tail -20",
            "timeout": 300,
            "statusMessage": "Running tests..."
          }
        ]
      }
    ]
  }
}
